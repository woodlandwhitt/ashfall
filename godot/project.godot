; Ashfall: Meridian, Godot test build (a vertical slice of Dustwell to compare against the WebView build)
config_version=5

[application]

config/name="Ashfall Godot"
config/description="Ashfall: Meridian, native Godot test slice"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Sfx="*res://scripts/sfx.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[navigation]

3d/default_cell_size=0.5
3d/default_cell_height=0.25

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.62, 0.55, 0.45, 1)
