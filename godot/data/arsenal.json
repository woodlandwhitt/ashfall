ort enough for a corridor, long enough for the yard. Gantry security bought a crate of them."},"long_silence":{"n":"Long Silence","t":"weapon","kind":"rifle","glb":"lp_sniper","w":11,"v":780,"dmg":96,"rof":1.3,"ammo":"ammo_rifle","mag":5,"range":320,"spread":0.002,"desc":"A bolt-action rifle with a scope as long as your forearm. Whoever it's pointed at never hears it."},"rocket_tube":{"n":"Rocket Tube","t":"weapon","kind":"rifle","glb":"lp_launcher","finish":"olive","w":14,"v":900,"dmg":150,"rof":1.6,"ammo":"ammo_rocket","mag":1,"range":200,"spread":0.004,"proj":"rocket","r":6,"snd":"shotgun_far","desc":"Shoulder-fired, single shot, reloads slow. It ends arguments with robots, trucks and anything in between."},"capacitor_rifle":{"n":"Capacitor Rifle","t":"weapon","kind":"energy","ammo":"cell","energy":true,"glb":"lp_charge_rifle","w":8,"v":640,"dmg":72,"rof":1,"mag":6,"range":200,"spread":0.003,"beam":"#ffe066","desc":"Charges a bank of salvaged capacitors and dumps them down the barrel in one crack of lightning."},"beamer":{"n":"Beamer","t":"weapon","kind":"energy","ammo":"cell","energy":true,"glb":"lp_beamer","w":6,"v":420,"dmg":17,"rof":0.1,"mag":30,"range":110,"spread":0.01,"beam":"#ff5544","desc":"A prewar crowd-control laser. Ticks out a stream of short red pulses."},"pulse_carbine":{"n":"Pulse Carbine","t":"weapon","kind":"energy","ammo":"cell","energy":true,"glb":"bl/blaster_a","finish":"black","w":6,"v":470,"dmg":24,"rof":0.14,"mag":24,"range":130,"spread":0.01,"beam":"#55aaff","desc":"Meridian's last security carbine. Each pulse leaves a blue afterimage in the air."},"tesla_pistol":{"n":"Tesla Pistol","t":"weapon","kind":"energy","ammo":"cell","energy":true,"glb":"bl/blaster_c","w":3,"v":380,"dmg":30,"rof":0.45,"mag":10,"range":60,"spread":0.02,"beam":"#cfe8ff","ion":2.2,"desc":"A coil of copper and a prayer. Robots hate it; it fries their boards from the inside."},"plasma_lance":{"n":"Plasma Lance","t":"weapon","kind":"energy","ammo":"cell","energy":true,