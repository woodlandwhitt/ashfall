":true,"r":6,"dmg":20,"dur":11,"fuse":1.8,"glb":"bl/grenade_a","gs":0.42,"col":"#b04a2a"},"v":70,"desc":"Thermite and a fuse. Bursts into a wide patch of burning ground that lasts a long time."},"smoke":{"n":"Smoke Grenade","t":"aid","throw":true,"w":0.5,"nade":{"smoke":14,"r":6,"dmg":0,"fuse":1.5,"glb":"bl/grenade_b","gs":0.42,"col":"#7a7f74"},"v":35,"desc":"A grey cloud that nobody can see through, for fourteen seconds. Break contact, cross the open ground, or slip past."},"flashbang":{"n":"Flashbang","t":"aid","throw":true,"w":0.5,"nade":{"flash":4.5,"r":9,"dmg":4,"fuse":1.4,"col":"#9aa0a6"},"v":55,"desc":"A blinding crack that leaves everyone nearby stunned and staggering for a few seconds. Look away."},"cryo":{"n":"Cryo Grenade","t":"aid","throw":true,"w":0.5,"nade":{"cryo":8,"r":7,"dmg":30,"fuse":1.6,"col":"#7fd0ff"},"v":95,"desc":"Liquid nitrogen under pressure. Freezes everything nearby to a crawl for eight seconds."},"rad_nade":{"n":"Rad Grenade","t":"aid","throw":true,"w":0.5,"nade":{"rad":12,"r":6,"dmg":9,"fuse":1.8,"col":"#c9e23a"},"v":75,"desc":"Glowing slag in a lead shell. Leaves a cloud that sickens anything standing in it, you included."},"plasma_nade":{"n":"Plasma Grenade","t":"aid","throw":true,"w":0.5,"nade":{"r":7,"dmg":170,"fuse":1.6,"plasma":true,"col":"#55ff77"},"v":140,"desc":"A sphere of contained plasma. When the containment goes, so does everything in seven metres."},"nail_bomb":{"n":"Nail Bomb","t":"aid","throw":true,"w":0.5,"nade":{"r":8,"dmg":100,"fuse":2,"nails":3,"col":"#8b8f93"},"v":40,"desc":"A coffee tin of roofing nails and black powder. The ones it doesn't kill keep bleeding."},"prox_mine":{"n":"Proximity Mine","t":"aid","throw":true,"w":0.5,"nade":{"r":6,"dmg":150,"fuse":1,"mine":2.6,"col":"#5c6b48"},"v":110,"desc":"Throw it down; it arms in a second and goes off when something walks over it. Something includes you."},"dynamite":{"n":"Bundle of Dynamite","t":"aid","throw":true,"w":0.5,"nade":{"r":11,"dmg":165,"fuse":3.2,"col":"#b8322a"},"v":65,"desc":"Three sticks, one long fuse. Count to three and throw it far."},"hush":{"n":"Hush","t":"aid","drug":"hush","w":0.1,"v":50,"desc":"A painkiller autoinjector. +25 damage resistance and slow healing for two minutes. A little numbing in the head."},"redline":{"n":"Redline","t":"aid","drug":"redline","w":0.1,"v":60,"desc":"Combat stimulant in a red vial. Huge melee damage and +2 Strength for a minute, -2 Perception. Leaves you shaking afterwards."},"quickstep":{"n":"Quickstep","t":"aid","drug":"quickstep","w":0.1,"v":55,"desc":"Leg-jitter pills. Run faster, +3 Agility and more Action Points for 75 seconds, then a heavy crash."},"lucid":{"n":"Lucid","t":"aid","drug":"lucid","w":0.1,"v":70,"desc":"Prewar study aid. +3 Intelligence and +1 Perception for three minutes, and a steadier aim."},"silver_tongue":{"n":"Silver Tongue","t":"aid","drug":"silver_tongue","w":0.1,"v":65,"desc":"Honey lozenges laced with something. +3 Charisma for over three minutes."},"ironhide":{"n":"Ironhide","t":"aid","drug":"ironhide","w":0.2,"v":80,"desc":"A thick grey paste rubbed on the skin. +45 damage resistance, +2 Endurance, but slow and -2 Agility."},"glowcap_tea":{"n":"Glowcap Tea","t":"aid","drug":"glowcap_tea","w":0.3,"v":30,"desc":"Brewed from cave mushrooms. Steady healing for two and a half minutes, at the cost of a little radiation."},"nightjar":{"n":"Nightjar","t":"aid","drug":"nightjar","w":0.1,"v":60,"desc":"Eye drops from a ranger kit. See in the dark for four minutes. +1 Perception."},"overclock":{"n":"Overclock","t":"aid","drug":"overclock","w":0.1,"v":95,"desc":"Military combat stim. Action Points through the roof and reloads twice as fast for 45 seconds, then a brutal crash."},"bloodpack":{"n":"Bloodpack","t":"aid","drug":"bloodpack","w":0.3,"v":45,"desc":"A bag of preserved blood. Restores a lot of health fast, over thirty seconds."},"clover":{"n":"Four-Leaf","t":"aid","drug":"clover","w":0.1,"v":80,"desc":"Pressed clover in sugar. Nobody knows why it 